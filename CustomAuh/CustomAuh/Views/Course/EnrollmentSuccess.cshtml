@model EnrollmentSuccessViewModel

<h2>Enrollment Confirmation</h2>

<div class="alert alert-success">
    <h4>You have successfully enrolled in @Model.CourseTitle!</h4>
    <p>Enrollment Date: @Model.EnrolledDate.ToString("f")</p>
</div>

<div class="card">
    <div class="card-body">
        <h5 class="card-title">@Model.CourseTitle</h5>
        <p class="card-text">@Model.CourseDescription</p>
    </div>
</div>

<div class="mt-3">
    <a asp-action="Details" asp-controller="Courses" asp-route-id="@Model.CourseId" class="btn btn-primary">
        View Course Details
    </a>
    <a asp-action="Index" asp-controller="Home" class="btn btn-secondary">
        Back to Home
    </a>
</div>