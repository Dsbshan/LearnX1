@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid">
    <div class="row justify-content-center">
        <div class="col-xl-4 col-md-6 col-sm-8">
            <!-- Adjusted column sizes -->
            <div class="card">
                <div class="card-header">
                    <h2 class="text-center">Register</h2> <!-- Centered the heading -->
                </div>
                <div class="card-body">
                        <div class="row mb-3">
                            <div class="col-12">
                                <div class="form-group">
                                    <label class="mb-2">First Name</label>
                                    <input type="text" class="form-control" data-bind="value: firstName">
                                </div>
                            </div>
                        </div>
                        <div class="row mb-3">
                            <div class="col-12">
                                <div class="form-group">
                                    <label class="mb-2">Last Name</label>
                                    <input type="text" class="form-control" data-bind="value: lastName">
                                </div>
                            </div>
                        </div>
                        <div class="row mb-3">
                            <div class="col-12">
                                <div class="form-group">
                                    <label class="mb-2">Email</label>
                                    <input type="text" class="form-control" data-bind="value: email">
                                </div>
                            </div>
                        </div>
                        <div class="row mb-3">
                            <div class="col-12">
                                <div class="form-group">
                                    <label class="mb-2">User Name</label>
                                    <input type="text" class="form-control" data-bind="value: userName">
                                </div>
                            </div>
                        </div>
                        <div class="row mb-3">
                            <div class="col-12">
                                <div class="form-group">
                                    <label class="mb-2">Password</label>
                                    <input type="password" class="form-control" data-bind="value: password"> <!-- Changed to password type -->
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-12">
                                <!-- Centered the button -->
                                <button class="btn btn-primary mt-3 mb-3" data-bind="click: register">Register</button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/Register.js"></script>
}