@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<div class="container-fluid">
    <div class="row justify-content-center">
        <div class="col-xl-4 col-md-6 col-sm-8">
            <div class="card mt-5">
                <div class="card-header text-center">
                    <h2>Login</h2>
                </div>
                <div class="card-body">
                    <div class="form-group mb-3">
                        <label for="email">Email</label>
                        <input type="text" id="email" class="form-control" data-bind="value: email">
                    </div>
                    <div class="form-group mb-4">
                        <label for="password">Password</label>
                        <input type="password" id="password" class="form-control" data-bind="value: password">
                    </div>
                    <div class="d-grid">
                        <button class="btn btn-primary" data-bind="click: login">Login</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/Login.js"></script>
}
