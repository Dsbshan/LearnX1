<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - TechCity learn</title>

    <!-- Your existing CSS links -->
    <link rel="stylesheet" href="~/theme/core-ui/vendors/simplebar/css/simplebar.css">
    <link rel="stylesheet" href="~/theme/core-ui/css/vendors/simplebar.css">
    <link href="~/theme/core-ui/css/style.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/prismjs@1.23.0/themes/prism.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.2.0/css/all.min.css" integrity="sha512-xh6O/CkQoPOWDdYTDqeRdPCVd1SpvCA9XXcUnZS2FmJNp1coAFzvtCN9BmamE+4aHK8yyUHUSCcJHgXloTyT2A==" crossorigin="anonymous" referrerpolicy="no-referrer" />
    <link href="~/lib/izitoast/dist/css/izitoast.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="//code.jquery.com/ui/1.13.2/themes/base/jquery-ui.css">
    <link href="~/lib/sweet-alert/sweetalert2.css" rel="stylesheet" />
    <link href="~/lib/izimodal/css/izimodal.min.css" rel="stylesheet" />
    <link href="~/css/loader.css" rel="stylesheet" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link href="~/lib/bootstrap/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="~/css/site.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet">

    <style>
        :root {
            --primary-color: #6366f1;
            --secondary-color: #8b5cf6;
            --accent-color: #ec4899;
            --light-bg: #f9fafb;
            --dark-text: #1f2937;
            --light-text: #6b7280;
            --navbar-bg: #ffffff;
            --sidebar-width: 250px;
            --sidebar-collapsed-width: 80px;
        }

        body {
            font-family: 'Poppins', sans-serif;
            color: var(--dark-text);
            background-color: var(--light-bg);
            min-height: 100vh;
            display: flex;
            flex-direction: column;
        }
        /* Add these styles to your existing CSS */
        .nav-group-items {
            max-height: 0;
            overflow: hidden;
            transition: max-height 0.3s ease;
            padding-left: 20px;
        }

            .nav-group-items.show {
                max-height: 500px; /* Adjust based on your content */
            }

        .nav-group-toggle {
            cursor: pointer;
            position: relative;
        }

            .nav-group-toggle::after {
                content: '\f078';
                font-family: 'Font Awesome 6 Free';
                font-weight: 900;
                position: absolute;
                right: 20px;
                transition: transform 0.3s ease;
            }

            .nav-group-toggle.collapsed::after {
                transform: rotate(-90deg);
            }
        /* Sidebar styles - initially hidden */
        .sidebar {
            position: fixed;
            top: 0;
            left: 0;
            height: 100vh;
            width: var(--sidebar-width);
            background-color: white;
            box-shadow: 2px 0 10px rgba(0, 0, 0, 0.05);
            z-index: 1000;
        }

            .sidebar.visible {
                display: block;
            }

        .sidebar-header {
            padding: 20px;
            border-bottom: 1px solid rgba(0, 0, 0, 0.05);
            text-align: center;
        }

        .sidebar-menu {
            padding: 20px 0;
        }

        .sidebar-item {
            padding: 12px 20px;
            display: flex;
            align-items: center;
            color: var(--dark-text);
            text-decoration: none;
            border-left: 3px solid transparent;
        }

            .sidebar-item:hover {
                background-color: rgba(99, 102, 241, 0.1);
                color: var(--primary-color);
                border-left-color: var(--primary-color);
            }

            .sidebar-item i {
                margin-right: 15px;
                width: 20px;
                text-align: center;
            }

        /* Adjust main content when sidebar is visible */
        main.sidebar-visible {
            margin-left: var(--sidebar-width);
        }

        footer.sidebar-visible {
            margin-left: var(--sidebar-width);
        }
    </style>
</head>
<body>
    <div class="loader-container" id="loaderWrapper" style="display: none;">
        <div class="loader"></div>
    </div>

    @if (Context.Session.GetString("Email") != null)
    {
        <div class="sidebar" id="sidebar">
            <div class="sidebar-header">
                <h4 class="mb-0">
                    <span class="sidebar-item-text">TechCity</span>
                </h4>
            </div>
            <ul class="sidebar-menu">
                <!-- Financial Section -->
                <li class="nav-group">
                    <a class="nav-link nav-group-toggle collapsed" href="#">
                        <i class="fas fa-wallet nav-icon"></i>
                        <span class="sidebar-item-text">Course Catalog</span>
                    </a>
                    
                            <ul class="nav-group-items">
                                <li class="nav-item">
                            <a class="nav-link" href="/Course/CreateCourse">
                                        <i class="fas fa-hand-holding-usd nav-icon"></i>
                                        <span>Create Course</span>
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" href="/Payments/History">
                                        <i class="fas fa-history nav-icon"></i>
                                        <span>Payment History</span>
                                    </a>
                                </li>
                            </ul>
                        
                   
                </li>

                <!-- Customer Management -->
                <li class="nav-group">
                    <a class="nav-link nav-group-toggle collapsed" href="#">
                        <i class="fas fa-users nav-icon"></i>
                        <span class="sidebar-item-text">Customers</span>
                    </a>
                    <ul class="nav-group-items">
                        <li class="nav-item">
                            <a class="nav-link" href="/Customers/Add">
                                <i class="fas fa-user-plus nav-icon"></i>
                                <span>Add Customer</span>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="/Customers/List">
                                <i class="fas fa-address-book nav-icon"></i>
                                <span>Customer Directory</span>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="/Customers/Activity">
                                <i class="fas fa-chart-line nav-icon"></i>
                                <span>Customer Activity</span>
                            </a>
                        </li>
                    </ul>
                </li>

                <!-- Productivity Tools -->
                <li class="nav-group">
                    <a class="nav-link nav-group-toggle collapsed" href="#">
                        <i class="fas fa-tools nav-icon"></i>
                        <span class="sidebar-item-text">Productivity</span>
                    </a>
                    <ul class="nav-group-items">
                        <li class="nav-item">
                            <a class="nav-link" href="/Notebook/Note">
                                <i class="fas fa-book nav-icon"></i>
                                <span>Notes</span>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="/Calendar/Events">
                                <i class="fas fa-calendar-alt nav-icon"></i>
                                <span>Calendar</span>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="/Tasks/Manager">
                                <i class="fas fa-tasks nav-icon"></i>
                                <span>Task Manager</span>
                            </a>
                        </li>
                    </ul>
                </li>

                <!-- System Section -->
                <li class="nav-group">
                    <a class="nav-link nav-group-toggle collapsed" href="#">
                        <i class="fas fa-cog nav-icon"></i>
                        <span class="sidebar-item-text">System</span>
                    </a>
                    <ul class="nav-group-items">
                        <li class="nav-item">
                            <a class="nav-link" href="/Settings/General">
                                <i class="fas fa-sliders-h nav-icon"></i>
                                <span>Settings</span>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="/System/Users">
                                <i class="fas fa-user-cog nav-icon"></i>
                                <span>User Management</span>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="/System/Audit">
                                <i class="fas fa-clipboard-list nav-icon"></i>
                                <span>Audit Logs</span>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="/System/Backup">
                                <i class="fas fa-database nav-icon"></i>
                                <span>Backup & Restore</span>
                            </a>
                        </li>
                    </ul>
                </li>

                <!-- Help & Support -->
                <li class="nav-group">
                    <a class="nav-link nav-group-toggle collapsed" href="#">
                        <i class="fas fa-question-circle nav-icon"></i>
                        <span class="sidebar-item-text">Help</span>
                    </a>
                    <ul class="nav-group-items">
                        <li class="nav-item">
                            <a class="nav-link" href="/Help/Documentation">
                                <i class="fas fa-book-open nav-icon"></i>
                                <span>Documentation</span>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="/Help/Support">
                                <i class="fas fa-headset nav-icon"></i>
                                <span>Contact Support</span>
                            </a>
                        </li>
                    </ul>
                </li>

                <li class="nav-item">
                    <a class="nav-link" href="/Account/Logout">
                        <i class="fas fa-sign-out-alt nav-icon"></i>
                        <span class="sidebar-item-text">Logout</span>
                    </a>
                </li>
            </ul>
        </div>
    }
    <div class="wrapper d-flex flex-column min-vh-100 bg-light">
        <header>
            <div class="container-fluid">
                <nav class="navbar navbar-expand-lg navbar-light" id="mainNavbar">
                    <div class="container">
                        <a class="navbar-brand" href="/">
                            <i class="fas fa-lock-open me-2"></i>
                            Tech City Learn
                        </a>
                        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarContent">
                            <span class="navbar-toggler-icon"></span>
                        </button>

                        <div class="collapse navbar-collapse" id="navbarContent">
                            <ul class="navbar-nav me-auto">
                                <li class="nav-item">
                                    <a class="nav-link" href="/">
                                        <i class="fas fa-home me-1"></i> Home
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" href="/Home/Index1">
                                        <i class="fas fa-home me-1"></i> Home
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" href="/Notebook/Note">
                                        <i class="fas fa-book me-1"></i> Notes
                                    </a>
                                </li>
                            </ul>

                            <ul class="navbar-nav">
                                @if (Context.Session.GetString("Email") != null)
                                {
                                    <li class="nav-item">
                                        <span class="nav-link">
                                            <i class="fas fa-user-circle me-1"></i>
                                            @Context.Session.GetString("Email")
                                        </span>
                                    </li>
                                    <li class="nav-item">
                                        <a class="nav-link auth-btn" href="/Account/Logout">
                                            <i class="fas fa-sign-out-alt me-1"></i> Logout
                                        </a>
                                    </li>
                                }
                                else
                                {
                                    <li class="nav-item">
                                        <a class="nav-link auth-btn me-2" href="/Account/Login">
                                            <i class="fas fa-sign-in-alt me-1"></i> Login
                                        </a>
                                    </li>

                                    <li class="nav-item">
                                        <a class="nav-link auth-btn" href="/Account/Register">
                                            <i class="fas fa-user-plus me-1"></i> Register
                                        </a>
                                    </li>
                                }
                            </ul>
                            
                        </div>
                    </div>
                </nav>
            </div>
        </header>

        <div class="container-fluid" style="min-height:100vh;background-color:white">
            <div id="loaderWrapper" style="display:none">
                <div class="spinner"></div>
            </div>
            @RenderBody()
        </div>
    </div>

    <footer id="mainFooter">
        <div class="container-fluid text-center">
            <div class="mb-3">
                <a href="#" class="text-white mx-3"><i class="fab fa-github"></i></a>
                <a href="#" class="text-white mx-3"><i class="fab fa-linkedin-in"></i></a>
            </div>
            <p class="mb-0">&copy; @DateTime.Now.Year - My Auth App</p>
        </div>
    </footer>

    <!-- JavaScript files -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/Knockout.js"></script>
    <script src="~/js/Connector.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/lib/iziToast/dist/js/iziToast.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.2.0/js/all.min.js"></script>
    <script src="~/lib/moments/moment.min.js"></script>
    <script src="~/lib/moments/moment-with-locales.min.js"></script>
    <script src="//cdnjs.cloudflare.com/ajax/libs/numeral.js/2.0.6/numeral.min.js"></script>
    <script src="~/lib/sweet-alert/sweetalert2.all.js"></script>
    <script src="~/lib/izimodal/js/izimodal.min.js"></script>
   
  

    <script>
                $(document).ready(function() {
            // Check if user is logged in
            const isLoggedIn = '@Context.Session.GetString("Email")' !== '';

            if (isLoggedIn) {
                // Show sidebar
                $('#sidebar').addClass('visible');
                $('main').addClass('sidebar-visible');
                $('footer').addClass('sidebar-visible');
            }

            // Add toggle functionality for subcategories
            $('.nav-group-toggle').click(function(e) {
                e.preventDefault();
                $(this).toggleClass('collapsed');
                $(this).siblings('.nav-group-items').toggleClass('show');
            });
        });
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>