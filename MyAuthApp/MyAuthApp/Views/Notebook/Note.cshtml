@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<div class="card">
    <div class="card-header">
        <h2>Note</h2>
    </div>
    <div class="card-body">
        <form >
            <div class="form-group">
                <label for="noteId">ID</label>
                <input type="text" class="form-control" id="id" data-bind="value: id" placeholder="Enter note ID">
            </div>
            <div class="form-group">
                <label for="noteTitle">Title</label>
                <input type="text" class="form-control" id="title" data-bind="value: title" placeholder="Enter note title">
            </div>
            <div class="form-group">
                <label for="noteContent">Content</label>
                <textarea class="form-control" id="content" data-bind="value: content" rows="5" placeholder="Enter note content"></textarea>
            </div>
            <div class="d-grid">
                <button class="btn btn-primary" data-bind="click: saveNote">Note</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script src="~/js/diary.js"></script>
}