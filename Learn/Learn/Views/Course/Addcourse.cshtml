@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="p-6 bg-white border border-gray-200 rounded-lg shadow" data-bind="with: courseViewModel">
    <!-- Save Button -->
    <div class="flex justify-start mb-6">
        <button type="button"
                data-bind="click: saveCourse"
                class="text-white bg-blue-700 hover:bg-blue-800 focus:ring-4 focus:ring-blue-300
                font-medium rounded-md text-sm px-5 py-2.5 me-2 focus:outline-none">
            Save Course
        </button>
    </div>

    <!-- Form Fields -->
    <div class="grid grid-cols-4 gap-4 mb-6">
        <!-- Country Dropdown -->
        <div class="mb-5">
            <label for="countrySelect" class="block mb-2 text-sm font-medium text-gray-900">Country</label>
            <select id="countrySelect"
                    data-bind="value: country"
                    class="block py-2.5 px-0 w-full text-sm text-gray-500 bg-transparent border-black border-b-2 border-gray-200 appearance-none focus:outline-none focus:ring-0 focus:border-gray-200">
                <option value="">Choose a country</option>
                <option value="US">United States</option>
                <option value="CA">Canada</option>
                <option value="FR">France</option>
                <option value="DE">Germany</option>
            </select>
        </div>

        <!-- Field 2 -->
        <div class="mb-5">
            <label for="field2" class="block mb-2 text-sm font-medium text-gray-900">Field 2</label>
            <input type="text" id="field2"
                   placeholder="Enter Field 2"
                   data-bind="value: field2"
                   class="bg-gray-50 border border-black text-gray-900 text-sm rounded-md focus:ring-blue-500 focus:border-blue-500 block w-full p-2.5" />
        </div>

        <!-- Field 3 -->
        <div class="mb-5">
            <label for="field3" class="block mb-2 text-sm font-medium text-gray-900">Field 3</label>
            <input type="text" id="field3"
                   placeholder="Enter Field 3"
                   data-bind="value: field3"
                   class="bg-gray-50 border border-black text-gray-900 text-sm rounded-md focus:ring-blue-500 focus:border-blue-500 block w-full p-2.5" />
        </div>

        <!-- Field 4 -->
        <div class="mb-5">
            <label for="field4" class="block mb-2 text-sm font-medium text-gray-900">Field 4</label>
            <input type="text" id="field4"
                   placeholder="Enter Field 4"
                   data-bind="value: field4"
                   class="bg-gray-50 border border-black text-gray-900 text-sm rounded-md focus:ring-blue-500 focus:border-blue-500 block w-full p-2.5" />
        </div>

        <!-- Field 5 -->
        <div class="mb-5">
            <label for="field5" class="block mb-2 text-sm font-medium text-gray-900">Field 5</label>
            <input type="text" id="field5"
                   placeholder="Enter Field 5"
                   data-bind="value: field5"
                   class="bg-gray-50 border border-black text-gray-900 text-sm rounded-md focus:ring-blue-500 focus:border-blue-500 block w-full p-2.5" />
        </div>

        <!-- Field 6 -->
        <div class="mb-5">
            <label for="field6" class="block mb-2 text-sm font-medium text-gray-900">Field 6</label>
            <input type="text" id="field6"
                   placeholder="Enter Field 6"
                   data-bind="value: field6"
                   class="bg-gray-50 border border-black text-gray-900 text-sm rounded-md focus:ring-blue-500 focus:border-blue-500 block w-full p-2.5" />
        </div>

        <!-- Field 7 -->
        <div class="mb-5">
            <label for="field7" class="block mb-2 text-sm font-medium text-gray-900">Field 7</label>
            <input type="text" id="field7"
                   placeholder="Enter Field 7"
                   data-bind="value: field7"
                   class="bg-gray-50 border border-black text-gray-900 text-sm rounded-md focus:ring-blue-500 focus:border-blue-500 block w-full p-2.5" />
        </div>

        <!-- Field 8 -->
        <div class="mb-5">
            <label for="field8" class="block mb-2 text-sm font-medium text-gray-900">Field 8</label>
            <input type="text" id="field8"
                   placeholder="Enter Field 8"
                   data-bind="value: field8"
                   class="bg-gray-50 border border-black text-gray-900 text-sm rounded-md focus:ring-blue-500 focus:border-blue-500 block w-full p-2.5" />
        </div>
    </div>

    <!-- Video Upload Section -->
    <div class="mb-6">
        <label for="videoUpload" class="block mb-2 text-sm font-medium text-gray-900">Upload Video(s)</label>
        <input type="file" id="videoUpload"
               accept="video/*"
               multiple
               data-bind="event: { change: handleVideoUpload }"
               class="block w-full text-sm text-gray-900 border border-black rounded-md cursor-pointer bg-gray-50 focus:outline-none" />
    </div>
</div>


@section Scripts
{
    <script src="~/js/viewCourse.js"></script>
}