<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - LearnX</title>

    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />

    <style>
        .dropdown:hover .dropdown-menu {
            display: block;
        }
    </style>
</head>

<body class="bg-gray-50 text-gray-800 flex flex-col min-h-screen">
    <!-- Navbar -->
    <nav class="bg-gradient-to-r from-indigo-500 to-purple-600 text-white shadow-md fixed top-0 w-full z-50">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex justify-between h-16 items-center">
                <!-- Brand -->
                <div class="flex items-center space-x-2">
                    <i class="fas fa-graduation-cap text-xl"></i>
                    <a href="#" class="text-2xl font-bold">Learn<span class="text-yellow-300">X</span></a>
                </div>

                <!-- Nav Links -->
                <div class="hidden md:flex space-x-6 items-center">
                    <a href="/Authendication/Sign" class="hover:text-yellow-300 font-medium"><i class="fas fa-home me-1"></i> Register</a>
                    <a href="/Authendication/Login" class="hover:text-yellow-300 font-medium"><i class="fas fa-book-open me-1"></i> Login</a>
                    <a href="#" class="hover:text-yellow-300 font-medium"><i class="fas fa-chalkboard-teacher me-1"></i> Instructors</a>
                    <a href="#" class="hover:text-yellow-300 font-medium"><i class="fas fa-chalkboard-teacher me-1"></i> Instructors</a>
                    <a href="#" class="hover:text-yellow-300 font-medium"><i class="fas fa-chalkboard-teacher me-1"></i> Instructors</a>
                </div>

                <!-- Mobile Menu Toggle -->
                <div class="md:hidden">
                    <button id="menuToggle" class="text-white focus:outline-none">
                        <i class="fas fa-bars text-2xl"></i>
                    </button>
                </div>
            </div>
        </div>

        <!-- Mobile Menu -->
        <div id="mobileMenu" class="md:hidden hidden px-4 pb-4">
            <a href="#" class="block py-2 text-white"></a>
            <a href="#" class="block py-2 text-white">Courses</a>
            <a href="#" class="block py-2 text-white">Instructors</a>
            <a href="#" class="block py-2 text-white">Resources</a>
        </div>
    </nav>

    <!-- Content -->
    <div class="container mx-auto mt-20 p-4 flex-grow">
        <main role="main">
            @RenderBody()
        </main>
    </div>

    <!-- Footer -->
    <footer class="bg-gradient-to-r from-indigo-500 to-purple-600 text-white shadow-md w-full">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6">
            <div class="flex flex-col md:flex-row justify-between items-center">
                <!-- Brand -->
                <div class="flex items-center space-x-2 mb-4 md:mb-0">
                    <i class="fas fa-graduation-cap text-xl"></i>
                    <a href="#" class="text-2xl font-bold">Learn<span class="text-yellow-300">X</span></a>
                </div>

                <!-- Footer Links -->
                <div class="flex flex-col md:flex-row space-y-4 md:space-y-0 md:space-x-6 text-center md:text-left">
                    <a href="/Authendication/Sign" class="hover:text-yellow-300 font-medium"><i class="fas fa-home me-1"></i> Register</a>
                    <a href="/Authendication/Sign" class="hover:text-yellow-300 font-medium"><i class="fas fa-book-open me-1"></i> Courses</a>
                    <a href="#" class="hover:text-yellow-300 font-medium"><i class="fas fa-chalkboard-teacher me-1"></i> Instructors</a>
                    <a href="#" class="hover:text-yellow-300 font-medium"><i class="fas fa-info-circle me-1"></i> About</a>
                    <a href="#" class="hover:text-yellow-300 font-medium"><i class="fas fa-envelope me-1"></i> Contact</a>
                </div>

                <!-- Social Media -->
                <div class="flex space-x-4 mt-4 md:mt-0">
                    <a href="#" class="hover:text-yellow-300 text-xl"><i class="fab fa-facebook"></i></a>
                    <a href="#" class="hover:text-yellow-300 text-xl"><i class="fab fa-twitter"></i></a>
                    <a href="#" class="hover:text-yellow-300 text-xl"><i class="fab fa-instagram"></i></a>
                    <a href="#" class="hover:text-yellow-300 text-xl"><i class="fab fa-linkedin"></i></a>
                </div>
            </div>

            <!-- Copyright -->
            <div class="mt-6 pt-6 border-t border-purple-400 text-center text-sm">
                <p>&copy; @DateTime.Now.Year LearnX. All rights reserved.</p>
            </div>
        </div>
    </footer>

    <!-- Tailwind Script -->
    <script>
        // Toggle mobile menu
        document.getElementById('menuToggle').addEventListener('click', () => {
            const mobileMenu = document.getElementById('mobileMenu');
            mobileMenu.classList.toggle('hidden');
        });
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>